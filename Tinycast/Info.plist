<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Tinycast uses automation to perform system actions you explicitly run.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Tinycast uses Bluetooth access only when you run the Toggle Bluetooth action.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Tinycast</string>
    <key>NSCameraUsageDescription</key>
    <string>Tinycast uses the camera only when you open the Camera command to preview or take a photo.</string>
    <key>UTExportedTypeDeclarations</key>
    <array><dict><key>UTTypeIdentifier</key><string>com.tinycast.backup</string>
    <key>UTTypeConformsTo</key><array><string>public.data</string></array>
    <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>tinycast</string></array></dict>
    </dict></array>
</dict>
</plist>
